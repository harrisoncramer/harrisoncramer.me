---
import { Image } from "@astrojs/image/components";
import type { CollectionEntry } from "astro:content";
import { slugifyTag } from "../consts";
interface Props {
  post: CollectionEntry<"blog">;
  featured?: boolean;
}

const dateOptions: object = {
  year: "numeric",
  month: "long",
  day: "numeric",
};
const { post, featured } = Astro.props;
const { tags } = post.data;
---

<li class={`post ${featured ? "mb-12 list-none" : ""}`}>
  <a class="card" href={`/${post.slug}`}>
    <div class="frame">
      <Image
        format="avif"
        width={featured ? 900 : 750}
        aspectRatio={16 / 9}
        src={import(`../assets/posts/${post.data.heroImage}.jpg`)}
        alt={post.data.imageDescription}
        class="skeleton hero"
        fit="cover"
      />
    </div>
    <h2 class="title"><span class="title-text">{post.data.title}</span></h2>
    <time class="date" datetime={new Date(post.data.pubDate).toISOString()}>
      {new Date(post.data.pubDate).toLocaleDateString("en-US", dateOptions)}
    </time>
    <p class="description">{post.data.description}</p>
  </a>
  {
    tags && tags.length > 0 && (
      <div class="post-tags">
        {tags.map((tag) => (
          <a class="tag" href={`/tags/${slugifyTag(tag)}`}>
            {tag}
          </a>
        ))}
      </div>
    )
  }
</li>

<style>
  .card {
    @apply block text-app-white;
  }

  .frame {
    @apply overflow-hidden rounded-sm;
  }

  .hero {
    @apply block w-full transition duration-500 ease-out-expo;
  }

  @media (hover: hover) {
    .card:hover .hero,
    .card:focus-visible .hero {
      @apply scale-[1.03] brightness-110;
    }
  }

  .title {
    @apply mt-4 leading-tight;
  }

  .title-text {
    @apply bg-no-repeat transition-[background-size] duration-300 ease-out-expo;
    background-image: linear-gradient(theme("colors.app-blue"), theme("colors.app-blue"));
    background-position: 50% 100%;
    background-size: 0% 2px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    padding-bottom: 2px;
  }

  @media (hover: hover) {
    .card:hover .title-text,
    .card:focus-visible .title-text {
      background-size: 100% 2px;
    }
  }

  .date {
    @apply mt-2 block text-sm text-app-gray opacity-70;
    font-family: Lora;
  }

  .description {
    @apply mt-2 text-lg text-app-gray;
  }

  .post-tags {
    @apply mt-4 flex flex-wrap gap-2;
  }

  .tag {
    @apply rounded-sm border border-app-background-medium px-2 py-0.5 text-xs text-app-gray transition-colors duration-200;
    font-family: Lora;
  }

  .tag:hover,
  .tag:focus-visible {
    @apply border-app-blue text-app-blue;
  }
</style>
