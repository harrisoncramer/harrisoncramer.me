---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title={"Page not found"}
  description={"That page does not exist on harrisoncramer.me"}
>
  <div class="mt-4 flex flex-col gap-4">
    <h1 class="mb-4">Page not found</h1>
    <p>
      There's nothing at this address. The link may be out of date, or the post
      may have moved.
    </p>
    <p>
      Try the <a aria-label="software blog" href="/">software blog</a> for the
      full list of posts, or read a bit <a href="/about">about me</a>.
    </p>
  </div>
</Layout>
