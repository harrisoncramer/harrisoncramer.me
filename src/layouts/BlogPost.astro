---
import { basename } from "../utils";
import Social from "../components/Social.astro";
import { Image } from "@astrojs/image/components";
import type { CollectionEntry } from "astro:content";
type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, heroImage, imageDescription } =
  Astro.props;
const dateOptions: object = {
  year: "numeric",
  month: "long",
  day: "numeric",
};

const posts = await Astro.glob("../content/blog/*.{md,mdx}");
const url = basename(
  posts.find((post) => post.frontmatter.title === title)?.url,
  "/"
);

const formattedPublishDate = new Date(pubDate).toLocaleDateString(
  "en-US",
  dateOptions
);
---

<html lang="en">
  <head>
    <title>{title}</title>
    <style>
      .last-updated-on {
        font-style: italic;
      }
      .title {
        @apply leading-tight;
      }
      .edit-link {
        @apply inline-flex items-center gap-2 text-sm text-app-gray opacity-70 transition-opacity duration-200;
        font-family: Lora;
      }
      .edit-link:hover,
      .edit-link:focus-visible {
        @apply opacity-100;
      }
      .edit-link svg {
        @apply h-4 w-4;
      }
      .blog-post-content :global(:is(h2, h3, h4)) {
        @apply mt-6 leading-tight;
        scroll-margin-top: 5rem;
      }
      .blog-post-content :global(:is(p, li)) {
        font-size: 1.1em;
        line-height: 1.75;
        color: #e8ebed;
      }
      .blog-post-content :global(:not(pre) > code) {
        @apply rounded-sm bg-app-background-light px-1.5 py-0.5 text-app-gray;
        font-size: 0.85em;
      }
      .blog-post-content :global(blockquote) {
        @apply m-0 border-l-2 border-app-blue pl-5 italic text-app-gray;
        font-family: Lora;
      }
      .blog-post-content :global(a) {
        @apply underline decoration-app-blue/40 decoration-1 underline-offset-4 transition-[text-decoration-color] duration-200;
      }
      .blog-post-content :global(a:hover),
      .blog-post-content :global(a:focus-visible) {
        @apply decoration-app-blue decoration-2;
      }
      .blog-post-content {
        @apply flex flex-col gap-6 mb-24;
        ul li {
          @apply list-disc ml-6;
        }
        ol li {
          @apply list-decimal ml-6;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <article data-pagefind-body>
        <h1 class="title" data-pagefind-meta="title">{title}</h1>
        <p class="text-lg mb-8 text-app-gray-light" data-pagefind-meta="description">{description}</p>
        <div class="flex items-center gap-2 mb-3" data-pagefind-ignore>
          <time class="flex-1 font-['Lora'] text-sm text-app-gray-dim" datetime={new Date(pubDate).toISOString()}>{formattedPublishDate}</time>
          <a
            class="edit-link"
            href={`https://github.com/harrisoncramer/harrisoncramer.me/blob/main/src/content/blog/${url}`}
          >
            Edit this page on Github
            <svg aria-hidden="true" viewBox="0 0 128 128" fill="currentColor">
              <path
                d="M64 5.103c-33.347 0-60.388 27.035-60.388 60.388 0 26.682 17.303 49.317 41.297 57.303 3.017.56 4.125-1.31 4.125-2.905 0-1.44-.056-6.197-.082-11.243-16.8 3.653-20.345-7.125-20.345-7.125-2.747-6.98-6.705-8.836-6.705-8.836-5.48-3.748.413-3.67.413-3.67 6.063.425 9.257 6.223 9.257 6.223 5.386 9.23 14.127 6.562 17.573 5.02.542-3.903 2.107-6.568 3.834-8.076-13.413-1.525-27.514-6.704-27.514-29.843 0-6.593 2.36-11.98 6.223-16.21-.628-1.52-2.695-7.662.584-15.98 0 0 5.07-1.623 16.61 6.19C53.7 35 58.867 34.327 64 34.304c5.13.023 10.3.694 15.127 2.033 11.526-7.813 16.59-6.19 16.59-6.19 3.287 8.317 1.22 14.46.593 15.98 3.872 4.23 6.215 9.617 6.215 16.21 0 23.194-14.127 28.3-27.574 29.796 2.167 1.874 4.097 5.55 4.097 11.183 0 8.08-.07 14.583-.07 16.572 0 1.607 1.088 3.49 4.148 2.897 23.98-7.994 41.263-30.622 41.263-57.294C124.388 32.14 97.35 5.104 64 5.104z"
              ></path>
              <path
                d="M26.484 91.806c-.133.3-.605.39-1.035.185-.44-.196-.685-.605-.543-.906.13-.31.603-.395 1.04-.188.44.197.69.61.537.91zm2.446 2.729c-.287.267-.85.143-1.232-.28-.396-.42-.47-.983-.177-1.254.298-.266.844-.14 1.24.28.394.426.472.984.17 1.255zM31.312 98.012c-.37.258-.976.017-1.35-.52-.37-.538-.37-1.183.01-1.44.373-.258.97-.025 1.35.507.368.545.368 1.19-.01 1.452zm3.261 3.361c-.33.365-1.036.267-1.552-.23-.527-.487-.674-1.18-.343-1.544.336-.366 1.045-.264 1.564.23.527.486.686 1.18.333 1.543zm4.5 1.951c-.147.473-.825.688-1.51.486-.683-.207-1.13-.76-.99-1.238.14-.477.823-.7 1.512-.485.683.206 1.13.756.988 1.237zm4.943.361c.017.498-.563.91-1.28.92-.723.017-1.308-.387-1.315-.877 0-.503.568-.91 1.29-.924.717-.013 1.306.387 1.306.88zm4.598-.782c.086.485-.413.984-1.126 1.117-.7.13-1.35-.172-1.44-.653-.086-.498.422-.997 1.122-1.126.714-.123 1.354.17 1.444.663zm0 0"
              ></path>
            </svg>
          </a>
        </div>
        {
          heroImage && (
            <>
              <Image
                format="avif"
                width={900}
                aspectRatio={16 / 9}
                src={import(`../assets/posts/${heroImage}.jpg`)}
                alt={imageDescription}
                class="skeleton rounded-sm"
                fit="cover"
              />
              <Social title={title} />
            </>
          )
        }
        <div class="blog-post-content mt-4">
          <slot />
        </div>
      </article>
    </main>
  </body>
  <script is:inline>
    document.querySelectorAll("div[data-rehype-pretty-code-fragment]").forEach(function(block) {
      var btn = document.createElement("button");
      btn.className = "code-copy-btn";
      btn.textContent = "Copy";
      block.style.position = "relative";
      block.appendChild(btn);
      btn.addEventListener("click", function() {
        var code = block.querySelector("pre code");
        if (code) {
          navigator.clipboard.writeText(code.innerText).then(function() {
            btn.textContent = "Copied!";
            setTimeout(function() { btn.textContent = "Copy"; }, 1500);
          });
        }
      });
    });
  </script>
</html>
